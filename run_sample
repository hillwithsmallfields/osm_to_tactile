#!/bin/bash

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

source $SCRIPT_DIR/env/bin/activate

SCALE=750
SCALE=1250
SCALE=5000
SCALE=2500

SVGFILE=etterbeek-$SCALE.svg

time $SCRIPT_DIR/src/osm_to_tactile/osm_to_tactile.py \
    --osmurl https://www.openstreetmap.org/#map=16/50.83677/4.38893 \
    --width 600 --height 400 \
    --output $SVGFILE \
    --language nl \
    --grid \
    --scale $SCALE \
    --label-streets \
    --topology etterbeek-$SCALE.yaml \
    --squash 2

inkscape $SVGFILE
